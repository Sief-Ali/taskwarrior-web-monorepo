{
  "name": "taskwarrior",
  "version": "1.0.0",
  "private": true,
  "description": "Convenience workspace for the TaskWarrior API and web client",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"pnpm --filter ./server dev\" \"pnpm --filter ./client dev\"",
    "dev:server": "pnpm --filter ./server dev",
    "dev:client": "pnpm --filter ./client dev",
    "build": "pnpm --filter ./server build && pnpm --filter ./client build",
    "start": "concurrently \"pnpm --filter ./server start\" \"pnpm --filter ./client start\"",
    "test": "pnpm --filter ./server test",
    "lint": "pnpm --filter ./server lint && pnpm --filter ./client lint",
    "test:server": "pnpm --filter ./server test"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
